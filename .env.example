# Flight Price Tracker Environment Configuration

# Path to the SQLite database
DB_PATH=data/flights.db

# Timezone for APScheduler and logs (e.g. America/Los_Angeles, Asia/Kolkata, UTC)
TZ=Asia/Kolkata

# Default currency (INR, USD, CAD, EUR, GBP, AUD)
CURRENCY=INR

# Poll interval in minutes (default 480 = 8 hours, minimum 15)
POLL_INTERVAL_MINUTES=480

# ── Push Notifications (All optional — configure whichever you use) ──
# Discord Webhook (Free, instant push on mobile & desktop)
DISCORD_WEBHOOK_URL=

# Telegram Bot (Free)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Pushover
PUSHOVER_TOKEN=
PUSHOVER_USER=
